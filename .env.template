# ====================================
# Browser Automation Platform - Configuration Template
# ====================================

# ==================== 数据库配置 (必填) ====================
# SQL Server 连接字符串
# 格式: mssql+aioodbc://用户名:密码@服务器:端口/数据库名?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
# 示例: mssql+aioodbc://sa:MyPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8

# ==================== 应用配置 ====================
# Web 服务监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 调试模式 (开发环境: true, 生产环境: false)
DEBUG=false

# ==================== 浏览器配置 ====================
# 无头模式 (true=后台运行, false=显示浏览器窗口)
# 登录态更新时会自动使用有头模式，任务执行使用此配置
HEADLESS_MODE=true

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径 (可选，留空则只输出到控制台)
# LOG_FILE=logs/app.log

# ==================== 并发控制配置 ====================
# 最大工作进程数 (同时执行的任务数)
# 建议值: 低配机器 2-3, 中配机器 3-5, 高配机器 5-10
MAX_WORKERS=3

# 工作进程内存限制 (MB)
WORKER_MEMORY_LIMIT_MB=512

# ==================== 任务调度配置 ====================
# 待处理任务分发间隔 (分钟)
DISPATCH_INTERVAL_MINUTES=30

# 失败任务重试间隔 (分钟)
RETRY_INTERVAL_MINUTES=30

# 最大重试次数
MAX_RETRY_COUNT=3

# 每批重试的任务数量
RETRY_BATCH_SIZE=100

# ==================== 智能重试配置 ====================
# 失败后至少等待多久才重试 (分钟)
# 建议值: 根据任务总量和限流计算，公式: 预计全量任务耗时 × 0.8
# 示例: 1000个任务需16小时 → 设置为 800 分钟
RETRY_MIN_WAIT_MINUTES=60

# 如果 pending 任务超过此数量，跳过重试
# 建议值: 总任务数 × 0.1
# 作用: 优先处理新任务，避免重试任务竞争
RETRY_SKIP_IF_PENDING_OVER=100

# 重试时是否遵守限流 (true=避免重试加重限流压力)
RETRY_RESPECT_RATE_LIMIT=true

# ==================== 限流控制配置 ====================
# 是否启用限流 (目标网站有访问频率限制时必须启用)
RATE_LIMIT_ENABLED=false

# 限流时间窗口 (分钟)
# 建议值: 30-120 分钟
RATE_LIMIT_WINDOW_MINUTES=60

# 时间窗口内最多执行的任务数
# 建议值: 根据目标网站的限制设置，通常 50-300
# 示例配置:
#   严格限流: 60分钟/50任务 (每小时50个)
#   中等限流: 60分钟/100任务 (每小时100个)
#   宽松限流: 60分钟/300任务 (每小时300个)
RATE_LIMIT_MAX_TASKS=100

# 是否按配置ID分别限流
# true=每个配置独立计数, false=全局统一计数
# 建议: 多站点采集时设为 true
RATE_LIMIT_PER_CONFIG=false

# ==================== 告警配置 (可选) ====================
# 邮件告警配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_password
# ALERT_EMAIL_FROM=alert@example.com
# ALERT_EMAIL_TO=admin@example.com

# 钉钉机器人 Webhook (可选)
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人 Webhook (可选)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

