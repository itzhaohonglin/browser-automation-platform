# ==================== 鏁版嵁搴撻厤缃?(蹇呭～) ====================
# SQL Server 杩炴帴瀛楃涓?
# 鏍煎紡: mssql+aioodbc://鐢ㄦ埛鍚?瀵嗙爜@鏈嶅姟鍣?绔彛/鏁版嵁搴撳悕?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
# 绀轰緥: mssql+aioodbc://sa:MyPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8

# ==================== 搴旂敤閰嶇疆 ====================
# Web 鏈嶅姟鐩戝惉鍦板潃鍜岀鍙?
APP_HOST=0.0.0.0
APP_PORT=8000

# 璋冭瘯妯″紡 (寮€鍙戠幆澧? true, 鐢熶骇鐜: false)
DEBUG=false

# ==================== 娴忚鍣ㄩ厤缃?====================
# 鏃犲ご妯″紡 (true=鍚庡彴杩愯, false=鏄剧ず娴忚鍣ㄧ獥鍙?
# 鐧诲綍鎬佹洿鏂版椂浼氳嚜鍔ㄤ娇鐢ㄦ湁澶存ā寮忥紝浠诲姟鎵ц浣跨敤姝ら厤缃?
HEADLESS_MODE=true

# ==================== 鏃ュ織閰嶇疆 ====================
# 鏃ュ織绾у埆: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 鏃ュ織鏂囦欢璺緞 (鍙€夛紝鐣欑┖鍒欏彧杈撳嚭鍒版帶鍒跺彴)
# LOG_FILE=logs/app.log

# ==================== 骞跺彂鎺у埗閰嶇疆 ====================
# 鏈€澶у伐浣滆繘绋嬫暟 (鍚屾椂鎵ц鐨勪换鍔℃暟)
# 寤鸿鍊? 浣庨厤鏈哄櫒 2-3, 涓厤鏈哄櫒 3-5, 楂橀厤鏈哄櫒 5-10
MAX_WORKERS=3

# 宸ヤ綔杩涚▼鍐呭瓨闄愬埗 (MB)
WORKER_MEMORY_LIMIT_MB=512

# ==================== 浠诲姟璋冨害閰嶇疆 ====================
# 寰呭鐞嗕换鍔″垎鍙戦棿闅?(鍒嗛挓)
DISPATCH_INTERVAL_MINUTES=30

# 澶辫触浠诲姟閲嶈瘯闂撮殧 (鍒嗛挓)
RETRY_INTERVAL_MINUTES=30

# 鏈€澶ч噸璇曟鏁?
MAX_RETRY_COUNT=3

# 姣忔壒閲嶈瘯鐨勪换鍔℃暟閲?
RETRY_BATCH_SIZE=100

# ==================== 鏅鸿兘閲嶈瘯閰嶇疆 ====================
# 澶辫触鍚庤嚦灏戠瓑寰呭涔呮墠閲嶈瘯 (鍒嗛挓)
# 寤鸿鍊? 鏍规嵁浠诲姟鎬婚噺鍜岄檺娴佽绠楋紝鍏紡: 棰勮鍏ㄩ噺浠诲姟鑰楁椂 脳 0.8
# 绀轰緥: 1000涓换鍔￠渶16灏忔椂 鈫?璁剧疆涓?800 鍒嗛挓
RETRY_MIN_WAIT_MINUTES=60

# 濡傛灉 pending 浠诲姟瓒呰繃姝ゆ暟閲忥紝璺宠繃閲嶈瘯
# 寤鸿鍊? 鎬讳换鍔℃暟 脳 0.1
# 浣滅敤: 浼樺厛澶勭悊鏂颁换鍔★紝閬垮厤閲嶈瘯浠诲姟绔炰簤
RETRY_SKIP_IF_PENDING_OVER=100

# 閲嶈瘯鏃舵槸鍚﹂伒瀹堥檺娴?(true=閬垮厤閲嶈瘯鍔犻噸闄愭祦鍘嬪姏)

# 鏄惁鍚敤闄愭祦 (鐩爣缃戠珯鏈夎闂鐜囬檺鍒舵椂蹇呴』鍚敤)

# 寤鸿鍊? 30-120 鍒嗛挓

# 鏃堕棿绐楀彛鍐呮渶澶氭墽琛岀殑浠诲姟鏁?
# 寤鸿鍊? 鏍规嵁鐩爣缃戠珯鐨勯檺鍒惰缃紝閫氬父 50-300
# 绀轰緥閰嶇疆:
#   涓ユ牸闄愭祦: 60鍒嗛挓/50浠诲姟 (姣忓皬鏃?0涓?
#   涓瓑闄愭祦: 60鍒嗛挓/100浠诲姟 (姣忓皬鏃?00涓?
#   瀹芥澗闄愭祦: 60鍒嗛挓/300浠诲姟 (姣忓皬鏃?00涓?

# 鏄惁鎸夐厤缃甀D鍒嗗埆闄愭祦
# true=姣忎釜閰嶇疆鐙珛璁℃暟, false=鍏ㄥ眬缁熶竴璁℃暟
# 寤鸿: 澶氱珯鐐归噰闆嗘椂璁句负 true


# ========================================
# 璇锋眰绾ч檺娴侀厤缃紙鍏ㄥ眬榛樿锛?
# ========================================
# 鎺у埗浠诲姟鎵ц杩囩▼涓瘡涓狧TTP璇锋眰鐨勯鐜?
# 閫傜敤鍦烘櫙锛氶槻姝㈠洜璇锋眰杩囧揩琚洰鏍囩綉绔欏皝绂?

# 鏄惁鍚敤璇锋眰绾ч檺娴侊紙true/false锛?
# 鐢熶骇鐜鎺ㄨ崘锛歵rue
REQUEST_RATE_LIMIT_ENABLED=true

# 姣忎釜HTTP璇锋眰涔嬮棿鐨勯棿闅旀椂闂达紙绉掞級
# 鐢熶骇鐜鎺ㄨ崘锛?锛堟瘡鍒嗛挓10涓姹傦級
REQUEST_RATE_LIMIT_INTERVAL_SECONDS=6

# 鎺ㄨ崘閰嶇疆锛?
# - 涓ユ牸闄愭祦锛堟斂搴滅綉绔欙級锛?0绉?
# - 涓瓑闄愭祦锛堜竴鑸綉绔欙級锛?绉?
# - 瀹芥澗闄愭祦锛堝唴閮ㄧ郴缁燂級锛?绉?
#
# 娉ㄦ剰锛?
# 1. 杩欐槸鍏ㄥ眬榛樿閰嶇疆锛屽鎵€鏈夐噰闆嗛厤缃敓鏁?
# 2. 鍙互鍦ㄦ暟鎹簱涓负鐗瑰畾閰嶇疆瑕嗙洊姝よ缃?
# 3. 淇敼鍚庨渶瑕侀噸鍚湇鍔℃墠鑳界敓鏁?
# 4. 鍒楄〃璇︽儏閲囬泦锛氭瘡涓鎯呴兘鏄竴涓姹?
#    绀轰緥锛?0鏉¤鎯?脳 6绉?= 绾?鍒嗛挓


# ===========================================
# ===========================================

# ===========================================
# 鑷姩閲嶆柊鎵ц閰嶇疆
# ===========================================
# 鏄惁鍚敤鑷姩閲嶆柊鎵ц锛堟墍鏈?success 浠诲姟浼氳嚜鍔ㄩ噸鏂版墽琛岋級
AUTO_RECREATE_SUCCESS_JOBS=true

# 浠诲姟瀹屾垚鍚庡涔呴噸鏂版墽琛岋紙鍒嗛挓锛?# 60 = 姣忓皬鏃? 360 = 姣?灏忔椂, 720 = 姣?2灏忔椂, 1440 = 姣忓ぉ
AUTO_RECREATE_INTERVAL_MINUTES=1440
