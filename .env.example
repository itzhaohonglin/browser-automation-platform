# ================================
# 应用配置
# ================================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# ================================
# 数据库配置（必填）
# ================================
# 格式: mysql+aiomysql://username:password@host:port/database
# 生产环境请使用强密码并限制访问权限
DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/bap

# ================================
# Playwright 配置
# ================================
# 是否使用无头模式（生产环境建议 True）
HEADLESS_MODE=False

# ================================
# 文件路径配置
# ================================
AUTH_FILES_DIR=auth_files

# ================================
# 日志配置
# ================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
