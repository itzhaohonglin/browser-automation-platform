# ====================================
# Browser Automation Platform - Configuration Template
# ====================================

# ==================== 数据库配置（必填） ====================
# SQL Server 连接字符串
# 格式: mssql+aioodbc://用户名:密码@服务器:端口/数据库名?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
# 示例: mssql+aioodbc://sa:MyPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8
DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost:1433/bap?driver=ODBC+Driver+17+for+SQL+Server&charset=UTF-8

# ==================== 应用配置 ====================
# Web 服务监听地址和端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 调试模式 (开发环境: true, 生产环境: false)
DEBUG=false

# ==================== 浏览器配置 ====================
# 无头模式 (true=后台运行, false=显示浏览器窗口)
# 登录态更新时会自动使用有头模式，任务执行使用此配置
HEADLESS_MODE=true

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径（启用后同时输出到文件和控制台）
LOG_FILE=logs/app.log

# 日志轮转策略: daily(按天), hourly(按小时), none(不轮转)
# daily: 每天午夜生成新文件，文件名如 app.log.20261022
# hourly: 每小时生成新文件，文件名如 app.log.20261022_14
# none: 不轮转，所有日志写入同一个文件
LOG_ROTATION=daily

# 日志保留天数（轮转模式下生效）
# daily: 保留最近 N 天的日志文件
# hourly: 保留最近 N*24 小时的日志文件
LOG_RETENTION_DAYS=10

# ==================== 进程池配置 ====================
# 最大工作进程数（同时执行的任务数）
# 建议值：低配机器（4核8G）2-3，中配（8核16G）3-5，高配（16核32G）5-10
MAX_WORKERS=1

# 工作进程内存限制（MB）
WORKER_MEMORY_LIMIT_MB=512

# ==================== 任务调度配置 ====================
# 待处理任务分发间隔（分钟）
# 建议值：快速处理 1-5 分钟，批量任务 10-30 分钟
DISPATCH_INTERVAL_MINUTES=1

# 失败任务重试间隔（分钟）
RETRY_INTERVAL_MINUTES=30

# 最大重试次数
MAX_RETRY_COUNT=3

# 每批重试的任务数量
RETRY_BATCH_SIZE=20

# ==================== 智能重试配置 ====================
# 失败后至少等待多久才重试（分钟）
# 建议值：预计全量任务耗时 × 0.8
# 示例：1000个任务需16小时 → 设置为 800 分钟
RETRY_MIN_WAIT_MINUTES=60

# 如果 pending 任务超过此数量，跳过失败任务重试
# 建议值：总任务数 × 0.1
# 作用：优先处理新任务，避免重试任务竞争
RETRY_SKIP_IF_PENDING_OVER=180

# ==================== 任务超时检测配置 ====================
# 是否启用任务超时检测
TASK_TIMEOUT_CHECK_ENABLED=true

# 任务超时阈值（分钟）
# 超过此时间的 processing 任务自动标记为 failed
TASK_TIMEOUT_MINUTES=30

# 超时检测间隔（分钟）
TASK_TIMEOUT_CHECK_INTERVAL_MINUTES=10

# ==================== 请求级限流配置 ====================
# 是否启用请求级限流（防止被目标网站封禁）
# 注意：这是全局默认值，可在数据库配置中为每个采集配置单独设置
REQUEST_RATE_LIMIT_ENABLED=false

# 每个 HTTP 请求之间的最小间隔时间（秒）
# 建议值：严格限流 10秒，中等限流 5-6秒，宽松限流 2-3秒
REQUEST_RATE_LIMIT_INTERVAL_SECONDS=5

# ==================== 认证文件配置 ====================
# 登录态文件存储目录
AUTH_FILES_DIR=auth_files

# ==================== 配置说明 ====================
# 1. DATABASE_URL 必须配置，否则程序无法启动
# 2. DISPATCH_INTERVAL_MINUTES 控制任务处理频率，设置为 1 分钟可快速响应
# 3. TASK_TIMEOUT_MINUTES 防止任务长时间卡住，默认 30 分钟超时
# 4. LOG_FILE 启用后会自动按天或按小时分类日志
# 5. 请求级限流建议启用，防止被目标网站封禁
# 6. 详细配置说明请参考: docs/package_config_quick_ref.md
